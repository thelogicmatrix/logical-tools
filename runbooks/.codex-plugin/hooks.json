{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Agent|spawn_agent", "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/router.mjs\" --agent --json", "timeout": 15, "statusMessage": "Routing subagent runbooks" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/router.mjs\" --json", "timeout": 15, "statusMessage": "Routing runbooks", "additionalContextLimit": 20000 } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/index.mjs\"", "timeout": 10, "statusMessage": "Loading runbooks", "additionalContextLimit": 20000 } ] }
    ]
  }
}
